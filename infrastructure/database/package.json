{
  "name": "@sdris/database",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=sdris-source --test \"src/**/*.spec.ts\"",
    "test:integration": "tsx --conditions=sdris-source --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "cli": "tsx --conditions=sdris-source src/cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sdris/shared-kernel": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "sdris-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "sdris-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "src/testing/index.ts"
      ]
    }
  }
}
