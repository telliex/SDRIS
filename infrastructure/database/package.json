{
  "name": "@sdris/database",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@sdris/shared-kernel": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "src/testing/index.ts"
      ]
    }
  }
}
