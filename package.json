{
  "name": "sdris",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sdris/web --filter @sdris/api --filter @sdris/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tests/bootstrap/*.test.mjs tests/architecture/*.test.mjs && pnpm -r --if-present test",
    "check:structure": "node scripts/verify-workspace.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "db:up": "docker compose -f deploy/local/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f deploy/local/docker-compose.yml down",
    "db:migrate": "pnpm --filter @sdris/database run cli migrate",
    "db:status": "pnpm --filter @sdris/database run cli status",
    "db:seed": "pnpm --filter @sdris/database run cli seed",
    "db:reset": "pnpm --filter @sdris/database run cli reset",
    "db:test": "pnpm --filter @sdris/database run test:integration && pnpm --filter @sdris/api run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^15",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^15",
    "prettier": "^3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  }
}
