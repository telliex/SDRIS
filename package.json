{
  "name": "sdris",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sdris/web --filter @sdris/api --filter @sdris/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test tests/bootstrap/*.test.mjs",
    "check:structure": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
