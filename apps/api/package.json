{
  "name": "@sdris/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=sdris-source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=sdris-source --test \"src/**/*.spec.ts\"",
    "test:integration": "tsx --conditions=sdris-source --test --test-concurrency=1 \"src/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10",
    "@sdris/database": "workspace:^",
    "@sdris/investigation": "workspace:^",
    "@sdris/shared-kernel": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
